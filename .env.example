# Paper Factory configuration

# --- Flask / dashboard ---
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0
FLASK_SECRET_KEY=dev-only-change-me

# --- Paths ---
DATA_DIR=./data
PAPERS_DIR=./papers
BACKUPS_DIR=./backups
LAB_DIR=./lab
DB_PATH=./data/state.db

# --- Claude API ---
# Toggle the mock LLM. 1 = canned responses, 0 = real anthropic SDK.
USE_MOCK_LLM=1
ANTHROPIC_API_KEY=

# --- Agent runtime ---
THREAD_POOL_SIZE=4
DISPATCHER_SWEEP_SECONDS=300

# --- Budget caps (USD) ---
PER_PAPER_DAILY_CAP=50
GLOBAL_DAILY_CAP=200

# --- External tool stubs ---
# 1 = stub these tools; 0 = use the real binary if present.
STUB_LATEX_COMPILE=0
STUB_GITHUB_MIRROR=1
STUB_PYTHON_SANDBOX=1
STUB_SCOUT=1

# --- SMTP (P2+) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
